{
  "name": "qqmusic-dl",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "description": "轻量 QQ 音乐下载服务：Web UI + Agent 可调度的 REST API",
  "author": "qqmusic-dl",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "desktop": "electron .",
    "dist": "electron-builder --win nsis --x64",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 test/run.test.js",
    "test:watch": "node --disable-warning=ExperimentalWarning --test --watch --test-concurrency=1 test/run.test.js",
    "lint": "eslint .",
    "format": "prettier --write eslint.config.js package.json test docs/architecture.md .github/workflows/ci.yml",
    "format:check": "prettier --check eslint.config.js package.json test docs/architecture.md .github/workflows/ci.yml",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@fastify/static": "^10.1.7",
    "fastify": "^5.12.7",
    "node-id3": "^0.2.8",
    "undici": "^6.29.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.13.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2"
  },
  "build": {
    "appId": "com.qqmusicdl.desktop",
    "productName": "qqmusic-dl",
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "public/**/*",
      "vendor/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "public/**/*",
      "vendor/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "qqmusic-dl",
      "uninstallDisplayName": "qqmusic-dl",
      "deleteAppDataOnUninstall": false,
      "artifactName": "qqmusic-dl-Setup-${version}.${ext}"
    }
  }
}
